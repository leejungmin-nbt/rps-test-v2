# =====================================================================
# 환경 변수 예시 — 향후 dev/prd 분리 시 사용
# =====================================================================
# 현재는 단일 환경(rps-test-e524c)이라 web/src/firebase.ts 에 firebaseConfig 가
# 직접 적혀 있다. 환경을 분리하려면:
#
#   1) 본 파일을 web/.env.development / web/.env.production 으로 복사
#   2) 각 파일에 해당 환경의 firebaseConfig 값을 채움
#   3) web/src/firebase.ts 의 firebaseConfig 객체를
#      import.meta.env.VITE_xxx 참조로 변경
#   4) .gitignore 가 .env.* 를 무시하도록 설정 (이미 처리됨)
#   5) Vite 가 빌드 모드에 따라 자동 선택:
#        npm run dev   → .env.development
#        npm run build → .env.production
#
# 자세한 가이드는 web/src/firebase.ts 상단 주석 참조.
# =====================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
